OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Без ключа маршруты /api/ai вернут fallback, а GET /api/ai/health вернёт ok: false (проверяется без вызова OpenRouter).
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Comma-separated list of allowed origins for /api/ai (exact scheme+host+port, not substring).
# Example: https://your-domain.com,https://www.your-domain.com
# Dev example: http://localhost:3003
# Leave empty in development; required in production.
ALLOWED_ORIGINS=

# Public site URL — used for OG metadata, sitemap, robots.txt host.
# Leave http://localhost:3003 in dev; set to real domain in prod.
# Capacitor APK: должен совпадать с деплоем, если WebView грузит другой origin — см. docs/android-apk.md
NEXT_PUBLIC_SITE_URL=http://localhost:3003
# Multi-user accounts and cloud state. Apply supabase/migrations before enabling.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Private owner access. When enabled, every app page redirects to /ru/login or /en/login
# until a signed HttpOnly session cookie is issued. Set these on the VPS, not in public code.
LIFEOS_AUTH_ENABLED=false
LIFEOS_AUTH_USER=dima
LIFEOS_AUTH_PASSWORD=change-this-password
# Generate a long random value, for example:
# openssl rand -base64 48
LIFEOS_AUTH_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# ┌────────────────────────────┬──────────────────────────────────────────────────────────────┐
# │ Переменная                 │ Назначение                                                   │
# ├────────────────────────────┼──────────────────────────────────────────────────────────────┤
# │ NEXT_PUBLIC_SITE_URL       │ Origin сайта для Next (OG, /api с клиента, deep links host). │
# │ CAPACITOR_SERVER_URL       │ URL, который подставляется в capacitor.config при cap sync   │
# │                            │ (удалённый WebView). Задаётся в окружении, не в .env обязат. │
# │ CAPACITOR_ALLOW_MIXED      │ true — разрешить mixed content в Android WebView (только если   │
# │                            │ осознанно нужно; prod HTTPS обычно не задаёт).               │
# └────────────────────────────┴──────────────────────────────────────────────────────────────┘
# Перед релизом: один и тот же host в NEXT_PUBLIC_SITE_URL и CAPACITOR_SERVER_URL (проверка: npm run check:capacitor-env).

# Опционально — перед npm run cap:sync задайте URL продакшена для загрузки приложения в WebView:
# set CAPACITOR_SERVER_URL=https://your-domain.example

# Comma-separated list of trusted reverse-proxy IPs whose X-Forwarded-For header
# is accepted for rate limiting. Leave empty to ignore XFF (safe default).
# Example: 10.0.0.1,10.0.0.2
TRUSTED_PROXIES=

# Optional — Upstash Redis for distributed rate limiting on /api/ai when running
# multiple Node workers or instances. Without these, limits are in-memory only.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
